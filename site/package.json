{
  "name": "minecraft-stream-guard-site",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.9",
  "type": "module",
  "description": "Full-screen live stream wall for StreamGuard — a Minecraft Paper/Spigot plugin.",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:architecture": "depcruise --config dependency-cruiser.cjs src",
    "check:docs": "node scripts/check-docs.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "ui:add": "node scripts/ui-registry.mjs add",
    "ui:check": "node scripts/ui-registry.mjs check",
    "ui:update": "node scripts/ui-registry.mjs update",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm check:architecture && pnpm check:docs && pnpm ui:check && pnpm build"
  },
  "engines": {
    "node": "^24 || ^26"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/oswald": "^5.2.5",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.0.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
